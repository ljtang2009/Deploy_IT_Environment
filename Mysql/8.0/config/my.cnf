[mysqld]
# 1. 基础设置
user=mysql
default-time-zone='+08:00'           # 设置时区为东八区
character-set-server=utf8mb4         # 设置字符集
collation-server=utf8mb4_unicode_ci  # 排序规则

# 2. 网络设置
bind-address=0.0.0.0                 # 允许外部访问
port=3306

# 3. 性能优化（根据你的机器配置调整，以下是适合 8G-16G 内存的参考值）
innodb_buffer_pool_size=1G           # 关键参数：设为物理内存的 60%-70%
innodb_log_file_size=256M            # 日志文件大小
innodb_flush_log_at_trx_commit=1     # 1 为最安全，2 为性能优先
innodb_flush_method=O_DIRECT          # Linux下推荐，Windows下默认即可，写上无副作用

# 4. 安全与日志
log_timestamps=SYSTEM                # 日志时间使用系统时间
slow_query_log=1                     # 开启慢查询日志
slow_query_log_file=/var/lib/mysql/mysql-slow.log
long_query_time=2                    # 超过2秒的查询记录

[client]
default-character-set=utf8mb4
