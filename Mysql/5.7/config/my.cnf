[mysqld]
# 字符集设置
character-set-server=utf8mb4
collation-server=utf8mb4_general_ci

# 时区设置 (针对你的所在地)
default-time-zone='+08:00'

# 性能优化基础配置
max_connections=200
max_connect_errors=100

# 开启慢查询日志 (排查问题必备)
slow_query_log=1
long_query_time=3

# 禁用域名解析 (提升连接速度)
skip-name-resolve

[client]
default-character-set=utf8mb4
